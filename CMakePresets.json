{
    "version": 3,
    "configurePresets": [
        {
            "name": "macos-x64-debug",
            "displayName": "macos-x64 Debug",
            "binaryDir": "${sourceDir}/bin",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos-x64",
            "displayName": "macos-x64",
            "binaryDir": "${sourceDir}/bin",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "linux-x64-debug",
            "displayName": "linux-x64 Debug",
            "binaryDir": "${sourceDir}/bin",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "environment": {
                "CC": "gcc-16",
                "CXX": "g++-16"
            }
        },
        {
            "name": "linux-x64",
            "displayName": "linux-x64",
            "binaryDir": "${sourceDir}/bin",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "environment": {
                "CC": "gcc-16",
                "CXX": "g++-16"
            }
        },
        {
            "name": "win-x64-debug",
            "displayName": "win-x64 Debug",
            "binaryDir": "${sourceDir}/bin",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "environment": {
                "PROJECT_ROOT": "${sourceDir}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "win-x64",
            "displayName": "win-x64",
            "binaryDir": "${sourceDir}/bin",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "environment": {
                "PROJECT_ROOT": "${sourceDir}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "win-x64-release",
            "displayName": "win-x64-release",
            "binaryDir": "${sourceDir}/bin",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            },
            "environment": {
                "PROJECT_ROOT": "${sourceDir}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ]
}