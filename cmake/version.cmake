# Writes OUTPUT (version.hpp) with ENIM_VERSION = major.minor.patch, run at every build (cmake -P).
# major.minor come from the most recent "X.Y.0" tag reachable from HEAD, patch is the number of commits since it.
# Usage: cmake -DSOURCE_DIR=<repo> -DOUTPUT=<path>/version.hpp -P version.cmake

set(ENIM_VERSION "0.0.0")

find_package(Git QUIET)
if (GIT_FOUND)
    # --match skips other tags, e.g. the rolling "latest" release tag
    execute_process(
        COMMAND ${GIT_EXECUTABLE} -C ${SOURCE_DIR} describe --tags --abbrev=0 --match "[0-9]*.[0-9]*.0"
        OUTPUT_VARIABLE base_tag
        RESULT_VARIABLE describe_result
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    if (describe_result EQUAL 0 AND base_tag MATCHES "^([0-9]+)\\.([0-9]+)\\.0$")
        set(major ${CMAKE_MATCH_1})
        set(minor ${CMAKE_MATCH_2})
        execute_process(
            COMMAND ${GIT_EXECUTABLE} -C ${SOURCE_DIR} rev-list --count ${base_tag}..HEAD
            OUTPUT_VARIABLE patch
            RESULT_VARIABLE count_result
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
        )
        if (count_result EQUAL 0)
            set(ENIM_VERSION "${major}.${minor}.${patch}")
        else()
            message(WARNING "version: git rev-list failed, using ${ENIM_VERSION}")
        endif()
    else()
        message(WARNING "version: no X.Y.0 tag found (shallow clone?), using ${ENIM_VERSION}")
    endif()
else()
    message(WARNING "version: git not found, using ${ENIM_VERSION}")
endif()

# file(CONFIGURE) only writes when the content changes, so an unchanged version recompiles nothing
file(CONFIGURE OUTPUT ${OUTPUT} CONTENT [[#pragma once
// generated by cmake/version.cmake
#define ENIM_VERSION "@ENIM_VERSION@"
]] @ONLY)
